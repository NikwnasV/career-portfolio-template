---
import { Icon } from 'astro-icon/components';
const { project } = Astro.props;
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';

// Map through the array of image strings from project JSON
const optimizedImages = await Promise.all(
  project.images.map(async (imgName: string) => {
    return await resolveAssetImage(imgName);
  })
);

const validImages = optimizedImages.filter(Boolean);

const isSlider = validImages.length > 1;
---

<div class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500">
  <div class={`aspect-video overflow-hidden relative ${project.imageStyle === "logo" ? "project-logo-surface" : "bg-background/50"}`}>
    <div class="absolute inset-0 bg-accent/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
    
    <div class={`w-full h-full relative ${isSlider ? 'image-slider' : ''}`}>
      {
        validImages.length > 0 ? (
          validImages.map((imgMetadata, index) => (
            <Image
              src={imgMetadata}
              alt={project.imageStyle === "logo" ? `${project.tech[0]} logo` : project.title}
              class={`absolute inset-0 w-full h-full ${project.imageStyle === "logo" ? "object-contain p-10 md:p-12" : "object-cover"} transition-all duration-1000 group-hover:scale-105 ${index === 0 ? "opacity-100 z-0" : "opacity-0 z-[-1]"}`}
            />
          ))
        ) : (
          <div class="project-identity flex flex-col items-center justify-center gap-3 w-full h-full p-8 text-center">
            <Icon name={project.visualIcon || 'mdi:code-braces'} class="w-14 h-14 text-accent" />
            <span class="font-heading text-2xl font-bold text-maintext">{project.visualLabel || project.title}</span>
            {project.visualSubtitle && <span class="text-xs text-subtext">{project.visualSubtitle}</span>}
          </div>
        )
      }
    </div>
    
    <div class="absolute top-3 right-3 flex gap-2 z-20">
      {project.platforms.map((p: string) => (
        <div class="p-1.5 bg-background backdrop-blur-md rounded-lg border border-accent/10 text-maintext">
          <Icon name={`mdi:${p}`} class="w-4 h-4" />
        </div>
      ))}
    </div>
  </div>

  <div class="p-6 space-y-4">
    <div class="flex justify-between items-start">
      <div>
        <span class="text-accent text-[10px] uppercase tracking-widest font-bold">{project.category}</span>
        <h3 class="text-xl font-heading font-bold text-maintext mt-1">{project.title}</h3>
      </div>
      {project.link?.trim() && project.link.trim() !== "#" && <a href={project.link} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title}`} class="text-accent/75 hover:text-accent transition-colors">
        <Icon name="mdi:open-in-new" class="w-6 h-6" />
      </a>}
    </div>

    <p class="text-subtext text-sm font-body">
      {project.description}
    </p>

    {project.linkLabel && project.link && <a href={project.link} class="inline-flex text-sm text-accent underline underline-offset-4">{project.linkLabel} →</a>}

    <div class="flex flex-wrap gap-2 pt-2">
      {project.tech.map((t: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-4 py-1 bg-accent/5 border border-accent/10 text-accent/80  group-hover:border-accent/40 group-hover:text-accent">
          {t}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  function initSliders() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const sliders = document.querySelectorAll('.image-slider');
    
    sliders.forEach(slider => {
      const images = slider.querySelectorAll('img');
      if (images.length <= 1) return;

      let currentIndex = 0;
      setInterval(() => {
        // Hide current
        images[currentIndex].classList.remove('opacity-100', 'z-0');
        images[currentIndex].classList.add('opacity-0', 'z-[-1]');
        
        // Move to next
        currentIndex = (currentIndex + 1) % images.length;
        
        // Show next
        images[currentIndex].classList.remove('opacity-0', 'z-[-1]');
        images[currentIndex].classList.add('opacity-100', 'z-0');
      }, 3500);
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', initSliders);
</script>

<style is:global>
  .project-logo-surface {
    /* A consistent light surface keeps the original brand colours readable in both themes. */
    background: #f5f5fa;
  }
  .project-identity {
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 75%);
  }
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition: 
      opacity 0.8s ease-out, 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>